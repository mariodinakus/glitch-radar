# Optional production-quality Greek translation. If absent, public MyMemory fallback has rate limits.
GOOGLE_TRANSLATE_API_KEY=

# Optional Telegram digest, configured only in Vercel Environment Variables.
CRON_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional GLITCH RADAR Web Push (generate via: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://glitch-radar-github.vercel.app
# Push needs the same UPSTASH_REDIS_REST_URL and UPSTASH_REDIS_REST_TOKEN as Telegram
