# Optional server-side digest via Vercel Cron. Keep these SECRET.
CRON_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional stateful deduplication: Upstash Redis REST (recommended)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional paid X trends. Without these, the Trends page still uses Google Search trends.
# Only enable if you accept X API metered charges; the server caches successful requests.
X_BEARER_TOKEN=
X_TRENDS_ENABLED=false

# X Trends: OFF by default to prevent metered API costs.
# Official X API: use `official` + X_BEARER_TOKEN (from X Developer Console)
# GetXAPI alternative: use `getxapi` + GETXAPI_KEY (3rd-party provider, paid)
X_TRENDS_PROVIDER=official
X_TRENDS_ENABLED=false
X_BEARER_TOKEN=
GETXAPI_KEY=
