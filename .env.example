# Optional production-quality Greek translation. If absent, public MyMemory fallback has rate limits.
GOOGLE_TRANSLATE_API_KEY=

# Optional Telegram digest, configured only in Vercel Environment Variables.
CRON_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional GLITCH RADAR Web Push (generate via: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://glitch-radar-github.vercel.app
# Push needs the same UPSTASH_REDIS_REST_URL and UPSTASH_REDIS_REST_TOKEN as Telegram

# GLITCH RADAR user accounts — Supabase Auth (Email OTP/magic link).
# Set Site URL to https://glitch-radar-github.vercel.app in Supabase.
# Allow https://glitch-radar-github.vercel.app/** as an Auth redirect.
# Run supabase/schema.sql once from the Supabase SQL editor.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. NEVER prefix with NEXT_PUBLIC_ and NEVER commit its value.
SUPABASE_SERVICE_ROLE_KEY=
# Personal push subscriptions are stored in Supabase, not in Redis.
