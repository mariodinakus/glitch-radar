# Optional server-side digest via Vercel Cron. Keep these SECRET.
CRON_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional stateful deduplication: Upstash Redis REST (recommended)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional paid X trends. Without these, the Trends page still uses Google Search trends.
# Only enable if you accept X API metered charges; the server caches successful requests.
X_BEARER_TOKEN=
X_TRENDS_ENABLED=false
