# Expo account / EAS Project ID, obtained after running npx eas-cli init
EXPO_PUBLIC_EAS_PROJECT_ID=
EXPO_PUBLIC_EAS_OWNER=
EXPO_PUBLIC_GLITCH_URL=https://glitch-radar-github.vercel.app
# Requires the same Supabase project as the GLITCH website (PUBLIC keys only).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# NEVER put Supabase service role keys, VAPID private keys or Expo access tokens here.
